parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        analyseAndScan:
            - src/NetBrothersVersionBundle.php
    ignoreErrors:
        -
            identifier: trait.unused
            path: src/Traits/VersionColumn.php

includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
