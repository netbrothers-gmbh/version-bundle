{
    "name": "netbrothers-gmbh/version-bundle",
    "description": "Trigger based version tables with MariaDB/MySQL and Doctrine",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Stefan Wessel",
            "email": "stefan.wessel@netbrothers.de"
        },
        {
            "name": "Thilo Ratnaweera",
            "email": "thilo.ratnaweera@netbrothers.de"
        }
    ],
    "keywords": [
        "bundle",
        "database",
        "versioning",
        "doctrine",
        "mysql",
        "mariadb"
    ],
    "require": {
        "php": ">=8.4",
        "symfony/console": "^7.4 || ^8.0",
        "doctrine/orm": "^3.6",
        "doctrine/dbal": "^4.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "NetBrothers\\VersionBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NetBrothers\\VersionBundle\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/netbrothers-version"
    ],
    "scripts": {
        "static-analysis": "phpstan analyse --no-progress",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
